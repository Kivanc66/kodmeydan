@model kodmeydan.Models.ProjectViewModel

@{
    ViewData["Title"] = "Projeni Düzenle";
}

<div class="form-wrap">
    <h2 class="form-title">⚙️ Projeni Düzenle</h2>

    <form asp-action="Edit" method="post">
        <div class="form-group">
            <label>Proje Adı</label>
            <input asp-for="Name" placeholder="Projenin adı..." />
            <span asp-validation-for="Name" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Kısa Tanım</label>
            <input asp-for="Description" placeholder="Tek cümlelik tanım..." />
            <span asp-validation-for="Description" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Etiket</label>
            <input asp-for="Ticket" placeholder="css, python, unity..." />
            <span asp-validation-for="Ticket" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>GitHub Bağlantısı</label>
            <input asp-for="GitHubUrl" placeholder="https://github.com/..." />
            <span asp-validation-for="GitHubUrl" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Canlı Demo Bağlantısı</label>
            <input asp-for="LiveDemoUrl" placeholder="https://..." />
            <span asp-validation-for="LiveDemoUrl" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Proje Kodu</label>
            <textarea asp-for="Code" placeholder="Kod parçacığı..."></textarea>
            <span asp-validation-for="Code" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Proje İçeriği</label>
            <textarea asp-for="Content" placeholder="Projeyi detaylıca anlat..."></textarea>
            <span asp-validation-for="Content" class="form-error"></span>
        </div>

        <div asp-validation-summary="All" class="form-error"></div>

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px;">Kaydet</button>
    </form>
</div>