@model kodmeydan.Models.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="form-wrap">
    <h2 class="form-title">🗝️ Giriş Yap</h2>

    <form asp-action="Login" method="post">
        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" placeholder="ornek@mail.com" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Şifre</label>
            <input asp-for="Password" type="password" placeholder="••••••••" />
            <span asp-validation-for="Password" class="form-error"></span>
        </div>

        <div asp-validation-summary="All" class="form-error"></div>

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px;">Giriş Yap</button>
    </form>

    <p style="text-align: center; margin-top: 20px; font-size: 0.8rem; color: var(--text-dim);">
        Hesabın yok mu? 
        <a asp-controller="Account" asp-action="Register" style="color: var(--gold);">Kayıt Ol</a>
    </p>
</div>