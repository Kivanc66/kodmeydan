@model kodmeydan.Models.RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="form-wrap">
    <h2 class="form-title">⚓ Kayıt Ol</h2>

    <form asp-action="Register" method="post">
        <div class="form-group">
            <label>Ad Soyad</label>
            <input asp-for="FullName" placeholder="Adın Soyadın" />
            <span asp-validation-for="FullName" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" placeholder="ornek@mail.com" />
            <span asp-validation-for="Email" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Şifre</label>
            <input asp-for="Password" type="password" placeholder="••••••••" />
            <span asp-validation-for="Password" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Şifre Tekrar</label>
            <input asp-for="ConfirmPassword" type="password" placeholder="••••••••" />
            <span asp-validation-for="ConfirmPassword" class="form-error"></span>
        </div>

        <div asp-validation-summary="All" class="form-error"></div>

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px;">Kayıt Ol</button>
    </form>

    <p style="text-align: center; margin-top: 20px; font-size: 0.8rem; color: var(--text-dim);">
        Zaten hesabın var mı? 
        <a asp-controller="Account" asp-action="Login" style="color: var(--gold);">Giriş Yap</a>
    </p>
</div>