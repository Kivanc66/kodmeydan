@model kodmeydan.Models.ArticleViewModel

@{
    ViewData["Title"] = "Makale Oluştur";
}

<div class="form-wrap">
    <h2 class="form-title">Makale Oluştur</h2>

    <form method="post" asp-action="Create">
        <div class="form-group">
            <label>Başlık</label>
            <input asp-for="Title" placeholder="Makalenin başlığı..." />
            <span asp-validation-for="Title" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Etiketler</label>
            <input asp-for="Ticket" placeholder="css, javascript, python..." />
            <span asp-validation-for="Ticket" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>İçerik</label>
            <textarea asp-for="Content" placeholder="Makale içeriği..."></textarea>
            <span asp-validation-for="Content" class="form-error"></span>
        </div>
        <div class="form-group">
            <label>Bağlantı (Yok İse Boş Bırakın)</label>
            <input asp-for="Link" placeholder="https://..." />
            <span asp-validation-for="Link" class="form-error"></span>
        </div>

        <div asp-validation-summary="All" class="form-error"></div>

        <button type="submit" class="btn-primary">Oluştur</button>
    </form>
</div>