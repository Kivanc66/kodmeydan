@model kodmeydan.Models.ArticleViewModel

@{
    ViewData["Title"] = "Makaleyi Düzenle";
}

<h1>Makaleyi Düzenle</h1>

<form asp-action="Edit" method="post">
    <div class="form-group">
        <label>Başlık</label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>
    <div class="form-group">
        <label>İçerik</label>
        <textarea asp-for="Content"></textarea>
        <span asp-validation-for="Content"></span>
    </div>
    <div class="form-group">
        <label>Etiket</label>
        <input asp-for="Ticket" />
        <span asp-validation-for="Ticket"></span>
    </div>
    <div class="form-group">
        <label>Bağlantı</label>
        <input asp-for="Link" />
        <span asp-validation-for="Link"></span>
    </div>
    <button type="submit" class="btn-primary">Kaydet</button>
</form>