@model kodmeydan.Models.Report

@{
    ViewData["Title"] = "Raporla";
}

<div class="form-wrap">
    <h2 class="form-title">🚩 Raporla</h2>

    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="ArticleId" />
        <input type="hidden" asp-for="ProjectId" />

        <div class="form-group">
            <label>Şikayet Nedeni</label>
            <textarea asp-for="Reason" placeholder="Neden raporluyorsunuz?"></textarea>
            <span asp-validation-for="Reason" class="form-error"></span>
        </div>

        <div asp-validation-summary="All" class="form-error"></div>

        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px;">Gönder</button>
    </form>
</div>